# External raw downloads — fetched by tools/fetch_external.py
# These are NOT redistributed (Fandom prohibits redistribution).
# Only the -processed/ outputs are committed.
source/fandom-raw/*
!source/fandom-raw/.gitkeep

# Build outputs — regenerated by the pipeline (build.py → fill_background →
# normalize → clean_background). Not committed: they're deterministic products
# of source/ + tools/, and CI publishes them as a Release artifact for zukan.
# Run `python3 tools/build.py` locally to regenerate.
data/*
!data/.gitkeep
icons/*
!icons/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
.idea/
.vscode/
