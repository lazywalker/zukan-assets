# External raw downloads — fetched by tools/fetch_external.py
# These are NOT redistributed (Fandom prohibits redistribution).
# Only the -processed/ outputs are committed.
source/fandom-raw/*
!source/fandom-raw/.gitkeep

# Build outputs — regenerated by the pipeline (build.py → fill_background →
# normalize → clean_background). Not committed: they're deterministic products
# of source/ + tools/, and CI publishes them as a Release artifact for zukan.
# Run `python3 tools/build.py` locally to regenerate.
data/*
!data/.gitkeep
icons/*
!icons/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db

# Editor
*.swp
.idea/
.vscode/

# Hand-drawn pixel sprites (pixelart/): the sprite configs are the source of
# truth; icons-pixelart/ is a deterministic build product, built at release
# time like data/ and icons/ (see pixelart/README.md). Dev previews in
# pixelart/ root are local-only too.
icons-pixelart/
pixelart/*.png

# Editor bundle and static dist are deterministic build products
# (build_editor_data.py); regenerated by editor_server.py / make editor.
pixelart/editor/_data/
pixelart/editor-dist/
